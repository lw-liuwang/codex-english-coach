{
  "name": "codex-english-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24.0.0 <25" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "npm run build -w @english-coach/shared && npm run build -w @english-coach/server && npm run build -w @english-coach/mcp && npm run build -w @english-coach/web",
    "typecheck": "npm run build -w @english-coach/shared && npm run typecheck --workspaces --if-present",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test",
    "setup": "node scripts/cli.mjs install",
    "start": "node scripts/cli.mjs start",
    "stop": "node scripts/cli.mjs stop",
    "doctor": "node scripts/cli.mjs doctor",
    "update": "node scripts/cli.mjs update",
    "uninstall": "node scripts/cli.mjs uninstall"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.2"
  }
}
